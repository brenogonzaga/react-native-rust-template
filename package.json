{
  "name": "react-native-rust-template",
  "version": "1.0.0",
  "description": "Production-ready React Native & Expo boilerplate template for executing high-performance Rust logic via Expo Native Modules, C FFI, and JNI.",
  "main": "index.ts",
  "keywords": [
    "react-native",
    "rust",
    "expo",
    "expo-native-module",
    "ffi",
    "jni",
    "mobile",
    "cross-platform",
    "swift",
    "kotlin",
    "boilerplate",
    "template"
  ],
  "dependencies": {
    "expo": "~57.0.9",
    "expo-localization": "~57.0.1",
    "expo-modules-core": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "i18n-js": "^4.5.3",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "rust-bridge": "file:./modules/rust-bridge"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.2",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "setup": "node scripts/setup.js setup",
    "preios": "node scripts/setup.js ios",
    "ios": "expo run:ios",
    "preandroid": "node scripts/setup.js android",
    "android": "expo run:android",
    "start": "expo start",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "prepare": "husky"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ],
    "*.rs": [
      "rustfmt --edition 2021"
    ]
  }
}
